# ============================================================
# TIC em Trilhas — Autopilot v17.0
# Copie para .env e preencha. O .env NÃO deve ser versionado.
# ============================================================

# ----- Chaves de API (pelo menos uma é necessária) -----
# NVIDIA NIM: https://build.nvidia.com/
TIC_NVIDIA_API_KEY=

# Groq: https://console.groq.com/keys
TIC_GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys
TIC_OPENROUTER_API_KEY=

# ----- Parâmetros do autopilot -----
# Nota mínima (0 a 10) para considerar o quiz aprovado
TIC_MIN_SCORE=6

# Tempo de espera antes de enviar o quiz (ms)
TIC_DELAY_QUIZ=1800

# Timeout por tentativa de IA (ms)
TIC_TIMEOUT=12000

# Cabeçalho HTTP-Referer enviado ao OpenRouter
TIC_OPENROUTER_REFERER=https://ticemtrilhas.instructure.com
